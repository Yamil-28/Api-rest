# El modo mock hace que TODAS las pantallas funcionen sin backend ni credenciales.
EXPO_PUBLIC_DATA_SOURCE=mock
# Cambiar a api SOLO cuando exista autenticacion funcional en el backend.
EXPO_PUBLIC_API_URL=https://api-rest-6an3.onrender.com
# IDs de perfil en tablas compradores/comerciantes (NO son necesariamente IDs de usuarios).
EXPO_PUBLIC_COMPRADOR_ID=1
EXPO_PUBLIC_COMERCIANTE_ID=1
